{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://iyccgbrarlvsaojzydjq.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "studytime-mcp",
      "version": "0.1.0",
      "title": "StudyTime MCP"
    },
    "tools": [
      {
        "name": "list_subjects",
        "title": "List study subjects",
        "description": "Return the signed-in user's study subjects with weekly targets.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_tasks",
        "title": "List study tasks",
        "description": "List the signed-in user's study tasks, optionally filtered by status or date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "completed"
              ],
              "description": "Filter by status."
            },
            "date": {
              "type": "string",
              "description": "YYYY-MM-DD; filter to this task_date."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max rows (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_task",
        "title": "Create study task",
        "description": "Create a new study task on the user's plan.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "What to study."
            },
            "subject_id": {
              "type": "string",
              "format": "uuid",
              "description": "Related study_subjects.id."
            },
            "task_date": {
              "type": "string",
              "description": "YYYY-MM-DD; defaults to today."
            },
            "duration_minutes": {
              "type": "integer",
              "minimum": 5,
              "maximum": 600,
              "description": "Planned duration (default 25)."
            },
            "difficulty": {
              "type": "string",
              "enum": [
                "easy",
                "medium",
                "hard"
              ]
            }
          },
          "required": [
            "topic"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "log_study_session",
        "title": "Log a completed study session",
        "description": "Record a completed focus session (minutes spent on a topic).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "time_spent_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "subject_id": {
              "type": "string",
              "format": "uuid"
            },
            "task_id": {
              "type": "string",
              "format": "uuid"
            },
            "accuracy_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "notes": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": [
            "topic",
            "time_spent_minutes"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_study_stats",
        "title": "Get study statistics",
        "description": "Total minutes studied and session count over the last N days (default 7), broken down by subject.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
